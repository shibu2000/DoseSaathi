<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.medchainalarm" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!-- Fires at the exact alarm time and posts the full-screen alarm notification -->
        <receiver
            android:name="expo.modules.medchainalarm.AlarmReceiver"
            android:exported="false" />

        <!-- Re-arms every stored alarm after a reboot / app update, without opening the app -->
        <receiver
            android:name="expo.modules.medchainalarm.BootReceiver"
            android:directBootAware="false"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Fires at the exact alarm time and posts the full-screen alarm notification -->
    <receiver
      android:name="expo.modules.medchainalarm.AlarmReceiver"
      android:exported="false" />

    <!-- Re-arms every stored alarm after a reboot / app update, without opening the app -->
    <receiver
      android:name="expo.modules.medchainalarm.BootReceiver"
      android:exported="true"
      android:directBootAware="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- Home screen widgets. Class names are kept stable so widgets users already placed survive updates. -->
    <receiver
      android:name="expo.modules.medchainalarm.widget.UpcomingDoseWidgetProvider"
      android:exported="true"
      android:label="@string/medchain_widget_scenic_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_upcoming_dose_info" />
    </receiver>

    <receiver
      android:name="expo.modules.medchainalarm.widget.GlassUpcomingDoseWidgetProvider"
      android:exported="true"
      android:label="@string/medchain_widget_glass_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_glass_upcoming_dose_info" />
    </receiver>
  </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel: translucent tint, diagonal specular sheen, hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A3F7F9F8" />
            <corners android:radius="@dimen/medchain_widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#66FFFFFF"
                android:centerColor="#00FFFFFF"
                android:centerX="0.45"
                android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/medchain_widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
            <corners android:radius="@dimen/medchain_widget_radius" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen medicine alarm (AlarmActivity). Colours and backgrounds are applied in code from the
  app theme + appearance, so this one layout serves every theme in light and dark.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Home-screen landscape along the bottom, behind the action card -->
    <ImageView
        android:id="@+id/alarm_art"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/alarm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <!-- Header: brand + eyebrow chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/alarm_brand_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/alarm_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/medchain_widget_brand"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/alarm_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/medchain_alarm_eyebrow"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/alarm_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textSize="72sp" />

            <TextClock
                android:id="@+id/alarm_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="a"
                android:format24Hour="a"
                android:textSize="18sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/alarm_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Pulsing medicine badge -->
        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/alarm_ring_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/alarm_ring_inner"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center" />

            <FrameLayout
                android:id="@+id/alarm_core"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:elevation="6dp">

                <ImageView
                    android:id="@+id/alarm_core_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_medication" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/alarm_med_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:maxLines="2"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_dosage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/alarm_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/alarm_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- Action card -->
        <LinearLayout
            android:id="@+id/alarm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/alarm_taken"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:clickable="true"
                android:contentDescription="@string/medchain_alarm_taken"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/alarm_taken_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_check" />

                <TextView
                    android:id="@+id/alarm_taken_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/medchain_alarm_taken"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/alarm_remind_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/medchain_alarm_remind_in"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alarm_snooze_10"
                    style="@style/MedchainAlarmSnoozeChip"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/alarm_snooze_20"
                    style="@style/MedchainAlarmSnoozeChip"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/alarm_snooze_30"
                    style="@style/MedchainAlarmSnoozeChip"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alarm_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/medchain_alarm_skip"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/alarm_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="·"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/alarm_details"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/medchain_alarm_details"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

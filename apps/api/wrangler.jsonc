{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dosesaathi",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medchain-d1",
      "database_id": "4998bf96-407f-47b9-a779-4a46b3dd2d87",
      "migrations_dir": "migrations"
    }
  ],
  // Retry sweep for the FCM outbox + housekeeping (every minute).
  "triggers": { "crons": ["* * * * *"] },
  // Non-secret config only. Secrets: wrangler secret put JWT_SECRET | PAIRING_PEPPER | FCM_SERVICE_ACCOUNT_JSON
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "",
    "ACCESS_TOKEN_TTL_SECONDS": "1800",
    // Shown on the public /privacy and /delete-account pages. Fill these in before publishing.
    "SUPPORT_EMAIL": "",
    "OPERATOR_NAME": ""
  }
}
